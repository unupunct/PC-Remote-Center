<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RemoteControlServer</AssemblyName>
    <RootNamespace>RemoteControlServer.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyTitle>PC Remote Center Server</AssemblyTitle>
    <Product>PC Remote Center</Product>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- do NOT request elevation: the server runs in the normal interactive user session -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global usings to avoid WPF name clashes -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteControlServer.Core\RemoteControlServer.Core.csproj" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
